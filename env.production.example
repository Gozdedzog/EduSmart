# EduSmart Production Environment Variables
# Copy this file to .env.production and update with your actual values

# Security
SECRET_KEY=your-super-secure-secret-key-here-change-this
JWT_SECRET=your-jwt-secret-key-here

# Domain Configuration
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com

# Database (if you add one later)
# DATABASE_URL=postgresql://user:password@db:5432/edusmart

# Email Configuration (if you add email features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Monitoring
# SENTRY_DSN=your-sentry-dsn-here

# External Services
# REDIS_URL=redis://redis:6379

# CORS Settings
ALLOWED_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Logging
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/app.log

# ML Model Configuration
ML_MODEL_PATH=./data/best_learning_model_full.joblib
ML_MODEL_CACHE_SIZE=100

# Performance
MAX_WORKERS=4
WORKER_TIMEOUT=30
