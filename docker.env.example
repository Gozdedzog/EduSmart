# EduSmart Docker Environment Variables
# Copy this file to .env and update with your actual values

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# Admin Configuration
# ===========================================
ADMIN_EMAILS=hll.aksngr@hotmail.com

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ML_API_URL=https://api.edusmart.tr

# ===========================================
# API Security Configuration
# ===========================================
SECRET_KEY=your-super-secure-secret-key-here-change-this
ALLOWED_ORIGINS=["https://edusmart.tr","https://www.edusmart.tr","https://api.edusmart.tr","http://localhost:3000","http://localhost:3001"]
ALLOWED_HOSTS=["*"]

# ===========================================
# API Configuration
# ===========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ML_MODEL_PATH=./data/best_learning_model_full.joblib
API_V1_STR=/api/v1
PROJECT_NAME=EduSmart API
VERSION=1.0.0
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# Optional: Database Configuration
# ===========================================
# DATABASE_URL=postgresql://user:password@db:5432/edusmart

# ===========================================
# Optional: Email Configuration
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ===========================================
# Optional: Monitoring
# ===========================================
# SENTRY_DSN=your-sentry-dsn-here
